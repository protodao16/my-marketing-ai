# Скопируй этот файл в .env и заполни значения. .env в git не попадает.

# ---- Anthropic (Claude) ----
# Ключ API из console.anthropic.com. Обязателен для генерации текстовок.
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude (по умолчанию — Opus 4.8)
CLAUDE_MODEL=claude-opus-4-8

# ---- Snov.io ----
# Оба значения берутся в настройках Snov.io -> вкладка API:
#   API User ID  -> SNOV_CLIENT_ID
#   API Secret   -> SNOV_CLIENT_SECRET
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# База API Snov.io (менять не нужно)
SNOV_API_BASE=https://api.snov.io
